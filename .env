# Параметры калькулятора и список биржевых slug через запятую.
CALCULATOR_EXCHANGES=binance,bybit,okx,mexc
SCREENER_QUOTE_SYMBOLS=USDT,USDC
CALCULATOR_CATEGORY=spot
CALCULATOR_PAGE_SIZE=500
CALCULATOR_CENTER_TYPE=all
CALCULATOR_SORT=cmc_rank_advanced
CALCULATOR_DIRECTION=desc
CALCULATOR_SPOT_UNTRACKED=true
# URL и параметры запроса к API CoinMarketCap для калькулятора.
CALCULATOR_API_URL=https://api.coinmarketcap.com/data-api/v3/cryptocurrency/market-pairs/latest
# Пороги спреда для фильтров панели: 0,85–1%, 1–1,5%, от 1,5%.
CALCULATOR_SPREAD_LEVELS=0.85,1,1.5
# true — показывать только прибыльное направление: покупка дешевле продажи.
# false — показывать обратное направление.
BUY_PRICE_MUST_BE_LOWER=true
# Сети для оценки времени перевода; остальные тикеры используют общий профиль эмулятора.
TRANSFER_NETWORK_MAP=BTC:BITCOIN,ETH:ETHEREUM,SOL:SOLANA,TON:TON,TRX:TRON,BNB:BSC
# Пауза между запросами к CoinMarketCap, в секундах.
CALCULATOR_REQUEST_DELAY_SECONDS=0.2
# Количество параллельных потоков калькулятора (от 1 до 8).
CALCULATOR_WORKERS=4
# Порт веб-интерфейса на локальном компьютере.
WEB_PORT=8080
