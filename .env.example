# Пороги спреда (не менее двух, по возрастанию); для каждого будет отдельный фильтр.
CALCULATOR_SPREAD_LEVELS=0.85,1,1.5
SCREENER_QUOTE_SYMBOLS=USDT,USDC

# Деморежим: реальные ордера и вывод средств не выполняются.
TRADER_TRAINING_MODE=1
TRADER_INITIAL_BALANCE_USD=100

# Пустая ставка означает: сначала запросить API, при недоступности не открывать сделку.
# Задавайте свои ставки аккаунта, например 0.001 для 0.1%.
TRADER_BINANCE_TAKER_FEE=
TRADER_BYBIT_TAKER_FEE=
TRADER_OKX_TAKER_FEE=
TRADER_MEXC_TAKER_FEE=

# Модель валюты списания торговой комиссии при покупке: base или quote.
TRADER_BINANCE_BUY_FEE_CURRENCY=quote
TRADER_BYBIT_BUY_FEE_CURRENCY=quote
TRADER_OKX_BUY_FEE_CURRENCY=quote
TRADER_MEXC_BUY_FEE_CURRENCY=quote

# Неизвестный маршрут в демо разрешён и помечается как предполагаемый.
# Явно выключенный ввод/вывод по умолчанию не обходится.
TRADER_ALLOW_UNCONFIRMED_ROUTE_DEMO=1
TRADER_ALLOW_DISABLED_ROUTE_DEMO=0
TRANSFER_NETWORK_MAP=BTC:BITCOIN,ETH:ETHEREUM,SOL:SOLANA,TON:TON,TRX:TRON,BNB:BSC
TRADER_TRANSFER_NETWORK=

# Фиксированное время перевода для воспроизводимости; альтернативно включить random и задать seed.
TRADER_FIXED_TRANSFER_SECONDS=300
TRADER_RANDOM_TRANSFER_TIME=0
TRADER_TRANSFER_RANDOM_SEED=12345

# Комиссия перевода обязательна: её можно получить из API биржи или задать явно с валютой.
TRADER_TRANSFER_FEE_AMOUNT=
TRADER_TRANSFER_FEE_CURRENCY=

# Минимальная прибыль после резерва и запас на изменение цены за время перевода.
TRADER_MIN_NET_PROFIT_USDT=0
TRADER_PRICE_MOVE_RESERVE_PERCENT=0.25

# Повторы временных сбоев и частичной продажи.
TRADER_SIGNAL_MAX_AGE_SECONDS=300
TRADER_SIGNAL_MAX_ATTEMPTS=5
TRADER_SETTLEMENT_RETRY_SECONDS=15
TRADER_SETTLEMENT_MAX_WAIT_SECONDS=3600
